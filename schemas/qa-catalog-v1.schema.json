{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wage-wiki.local/schemas/qa-catalog-v1.schema.json",
  "type": "object",
  "required": ["id", "as_of", "question", "expected", "required_authority_ids", "required_rule_ids", "forbidden_claims"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
    "as_of": {"type": "string", "format": "date"},
    "question": {"type": "string", "minLength": 1},
    "expected": {"type": "string", "minLength": 1},
    "required_authority_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
    "required_rule_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
    "forbidden_claims": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  },
  "additionalProperties": false
}
